#!/bin/sh /etc/rc.common
# CloudPub client (clo) service for OpenWrt.
# Publication reconciliation lives in cloudpub-run and mirrors the HA add-on.

. /lib/functions.sh

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/clo
SUPERVISOR=/usr/libexec/cloudpub-run

start_service() {
	local enabled token
	config_load cloudpub
	config_get_bool enabled main enabled 0
	config_get token main token

	[ "$enabled" -eq 1 ] || return 0
	[ -n "$token" ] || {
		logger -t cloudpub "API token is not set, service will not start"
		return 0
	}
	[ -x "$PROG" ] || {
		logger -t cloudpub "$PROG not found"
		return 1
	}
	[ -x "$SUPERVISOR" ] || {
		logger -t cloudpub "$SUPERVISOR not found"
		return 1
	}

	procd_open_instance cloudpub
	procd_set_param command "$SUPERVISOR"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "cloudpub"
	procd_add_reload_interface_trigger "wan"
}
