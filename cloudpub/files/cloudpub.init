#!/bin/sh /etc/rc.common
# CloudPub client (clo) service for OpenWrt
# Publications are managed via UCI (/etc/config/cloudpub) and LuCI.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/clo
CONFDIR=/etc/cloudpub
CONF=$CONFDIR/client.toml
HASHFILE=$CONFDIR/.publications.md5

clo() {
	HOME="$CONFDIR" "$PROG" -c "$CONF" "$@"
}

# Build a signature string of all publish sections so we only
# re-register publications when the UCI configuration changes.
sig_pub() {
	local cfg="$1"
	local enabled proto target name auth acl header
	config_get_bool enabled "$cfg" enabled 1
	config_get proto "$cfg" proto
	config_get target "$cfg" target
	config_get name "$cfg" name
	config_get auth "$cfg" auth
	config_get acl "$cfg" acl
	config_get header "$cfg" header
	SIG="$SIG|$enabled,$proto,$target,$name,$auth,$acl,$header"
}

register_pub() {
	local cfg="$1"
	local enabled proto target name auth acl header a h
	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get proto "$cfg" proto
	config_get target "$cfg" target
	if [ -z "$proto" ] || [ -z "$target" ]; then
		logger -t cloudpub "skipping publication '$cfg': protocol or address is not set"
		return 0
	fi
	config_get name "$cfg" name
	config_get auth "$cfg" auth
	config_get acl "$cfg" acl
	config_get header "$cfg" header

	set -- register
	[ -n "$name" ] && set -- "$@" --name "$name"
	[ -n "$auth" ] && [ "$auth" != "none" ] && set -- "$@" --auth "$auth"
	for a in $acl; do
		set -- "$@" --acl "$a"
	done
	for h in $header; do
		set -- "$@" --header "$h"
	done
	set -- "$@" "$proto" "$target"

	if clo "$@" >/dev/null 2>&1; then
		logger -t cloudpub "registered publication: $proto $target"
	else
		logger -t cloudpub "failed to register publication: $proto $target"
		SYNC_OK=0
	fi
}

sync_publications() {
	local token="$1" sig old

	SIG="$token"
	config_foreach sig_pub publish
	sig=$(echo "$SIG" | md5sum | cut -d' ' -f1)
	old=$(cat "$HASHFILE" 2>/dev/null)
	[ "$sig" = "$old" ] && return 0

	SYNC_OK=1
	# Remove previously registered publications of this agent and
	# re-register everything from the current UCI configuration.
	clo clean >/dev/null 2>&1 || SYNC_OK=0
	config_foreach register_pub publish

	if [ "$SYNC_OK" -eq 1 ]; then
		echo "$sig" > "$HASHFILE"
	else
		logger -t cloudpub "publication sync incomplete, will retry on next (re)start"
	fi
}

start_service() {
	local enabled token log_level unsafe_tls

	config_load cloudpub
	config_get_bool enabled main enabled 0
	config_get token main token
	config_get log_level main log_level "info"
	config_get_bool unsafe_tls main unsafe_tls 0

	[ "$enabled" -eq 1 ] || return 0

	if [ -z "$token" ]; then
		logger -t cloudpub "API token is not set, service will not start"
		return 0
	fi

	[ -x "$PROG" ] || {
		logger -t cloudpub "$PROG not found"
		return 1
	}

	mkdir -p "$CONFDIR"
	chmod 0700 "$CONFDIR"

	clo set token "$token" >/dev/null 2>&1
	if [ "$unsafe_tls" -eq 1 ]; then
		clo set unsafe_tls true >/dev/null 2>&1
	else
		clo set unsafe_tls false >/dev/null 2>&1
	fi

	sync_publications "$token"

	procd_open_instance cloudpub
	procd_set_param command "$PROG" -c "$CONF" -v -l "$log_level" run
	procd_set_param env HOME="$CONFDIR"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "cloudpub"
}
