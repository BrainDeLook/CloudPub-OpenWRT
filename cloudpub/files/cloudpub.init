#!/bin/sh /etc/rc.common
# CloudPub client (clo) service for OpenWrt
# Publications are managed via UCI (/etc/config/cloudpub) and LuCI.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/clo
CONFDIR=/etc/cloudpub
CONF=$CONFDIR/client.toml
STATEFILE=$CONFDIR/publications.state

clo() {
	HOME="$CONFDIR" "$PROG" -c "$CONF" "$@"
}

publication_signature() {
	local cfg="$1" enabled proto target name auth acl header
	config_get_bool enabled "$cfg" enabled 1
	config_get proto "$cfg" proto
	config_get target "$cfg" target
	config_get name "$cfg" name
	config_get auth "$cfg" auth
	config_get acl "$cfg" acl
	config_get header "$cfg" header
	printf '%s' "$enabled|$proto|$target|$name|$auth|$acl|$header" | md5sum | cut -d' ' -f1
}

state_lookup() {
	local cfg="$1"
	[ -s "$STATEFILE" ] || return 0
	awk -F '\t' -v section="$cfg" '$1 == section { print $2 "\t" $3; exit }' "$STATEFILE"
}

state_append() {
	printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$NEWSTATE"
}

extract_guid() {
	printf '%s\n' "$1" | grep -Eo '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}' | head -n1
}

register_pub() {
	local cfg="$1"
	local enabled proto target name auth acl header a h sig saved oldsig oldguid output guid
	config_get_bool enabled "$cfg" enabled 1
	sig="$(publication_signature "$cfg")"
	saved="$(state_lookup "$cfg")"
	oldsig="$(printf '%s\n' "$saved" | cut -f1)"
	oldguid="$(printf '%s\n' "$saved" | cut -f2)"
	[ -n "$saved" ] || { oldsig=""; oldguid=""; }

	if [ "$enabled" -ne 1 ]; then
		return 0
	fi
	config_get proto "$cfg" proto
	config_get target "$cfg" target
	if [ -z "$proto" ] || [ -z "$target" ]; then
		logger -t cloudpub "skipping publication '$cfg': protocol or address is not set"
		[ -z "$oldguid" ] || state_append "$cfg" "$oldsig" "$oldguid"
		return 0
	fi

	if [ -n "$oldguid" ] && [ "$sig" = "$oldsig" ]; then
		state_append "$cfg" "$sig" "$oldguid"
		return 0
	fi

	config_get name "$cfg" name
	config_get auth "$cfg" auth
	config_get acl "$cfg" acl
	config_get header "$cfg" header

	set -- register
	[ -n "$name" ] && set -- "$@" --name "$name"
	[ -n "$auth" ] && [ "$auth" != "none" ] && set -- "$@" --auth "$auth"
	for a in $acl; do
		set -- "$@" --acl "$a"
	done
	for h in $header; do
		set -- "$@" --header "$h"
	done
	set -- "$@" "$proto" "$target"

	if ! output="$(clo "$@" 2>&1)"; then
		logger -t cloudpub "failed to register publication: $proto $target: $output"
		[ -z "$oldguid" ] || state_append "$cfg" "$oldsig" "$oldguid"
		SYNC_OK=0
		return 0
	fi

	guid="$(extract_guid "$output")"
	if [ -z "$guid" ]; then
		# Newer clo versions may not print the internal endpoint UUID. The
		# registration itself still succeeded, so retain the signature and let
		# the client keep the endpoint alive; a later change will re-register it.
		logger -t cloudpub "registered publication (endpoint ID not reported): $proto $target"
		state_append "$cfg" "$sig" ""
		return 0
	fi

	state_append "$cfg" "$sig" "$guid"
	logger -t cloudpub "registered publication: $proto $target ($guid)"

	if [ -n "$oldguid" ] && [ "$oldguid" != "$guid" ]; then
		if clo unpublish "$oldguid" >/dev/null 2>&1; then
			logger -t cloudpub "removed replaced publication: $oldguid"
		else
			logger -t cloudpub "failed to remove replaced publication: $oldguid"
			SYNC_OK=0
		fi
	fi
}

remove_stale_publications() {
	local cfg sig guid
	[ -s "$STATEFILE" ] || return 0
	while IFS="$(printf '\t')" read -r cfg sig guid; do
		[ -n "$guid" ] || continue
		if ! awk -F '\t' -v section="$cfg" '$1 == section { found=1 } END { exit !found }' "$NEWSTATE"; then
			if clo unpublish "$guid" >/dev/null 2>&1; then
				logger -t cloudpub "removed deleted publication: $guid"
			else
				logger -t cloudpub "failed to remove deleted publication: $guid"
				state_append "$cfg" "$sig" "$guid"
				SYNC_OK=0
			fi
		fi
	done < "$STATEFILE"
}

sync_publications() {
	SYNC_OK=1
	NEWSTATE="$STATEFILE.tmp.$$"
	: > "$NEWSTATE"

	# Register only new or changed sections. Existing sections retain their
	# CloudPub GUID and public address; deleted sections are removed by GUID.
	config_foreach register_pub publish
	remove_stale_publications

	if [ "$SYNC_OK" -eq 1 ]; then
		mv "$NEWSTATE" "$STATEFILE"
		rm -f "$CONFDIR/.publications.md5"
	else
		mv "$NEWSTATE" "$STATEFILE"
		logger -t cloudpub "publication sync incomplete, failed entries will be retried on next (re)start"
	fi
}

start_service() {
	local enabled token log_level unsafe_tls

	config_load cloudpub
	config_get_bool enabled main enabled 0
	config_get token main token
	config_get log_level main log_level "info"
	config_get_bool unsafe_tls main unsafe_tls 0

	[ "$enabled" -eq 1 ] || return 0

	if [ -z "$token" ]; then
		logger -t cloudpub "API token is not set, service will not start"
		return 0
	fi

	[ -x "$PROG" ] || {
		logger -t cloudpub "$PROG not found"
		return 1
	}

	mkdir -p "$CONFDIR"
	chmod 0700 "$CONFDIR"

	clo set token "$token" >/dev/null 2>&1
	if [ "$unsafe_tls" -eq 1 ]; then
		clo set unsafe_tls true >/dev/null 2>&1
	else
		clo set unsafe_tls false >/dev/null 2>&1
	fi

	sync_publications

	procd_open_instance cloudpub
	procd_set_param command "$PROG" -c "$CONF" -v -l "$log_level" run
	procd_set_param env HOME="$CONFDIR"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "cloudpub"
}
