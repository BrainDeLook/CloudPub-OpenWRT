#!/bin/sh
# CloudPub publication reconciler for OpenWrt.
# This follows the Home Assistant add-on: client.toml is persistent, while
# clo ls is the source of truth for registered publication GUIDs.

PROG=/usr/bin/clo
CONFDIR=/etc/cloudpub
CONF=$CONFDIR/client.toml
LOG_LEVEL=info
REGISTERED=
DESIRED_GUIDS=/tmp/cloudpub-desired-guids.$$

log() {
	logger -t cloudpub "$*"
}

clo() {
	"$PROG" --conf "$CONF" --log-level "$LOG_LEVEL" "$@"
}

extract_guid() {
	printf '%s\n' "$1" | grep -Eio '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | head -n1
}

remember_guid() {
	local guid="$1"
	[ -n "$guid" ] || return 0
	grep -Fqx "$guid" "$DESIRED_GUIDS" 2>/dev/null || printf '%s\n' "$guid" >> "$DESIRED_GUIDS"
}

registered_guid_for_target() {
	local proto="$1" target="$2" line
	# Match the same address representation returned by `clo ls` and used by
	# the HA add-on. Keep the protocol in the match to avoid collisions.
	line="$(printf '%s\n' "$REGISTERED" | grep -F "${proto}://${target}" | head -n1)"
	extract_guid "$line"
}

register_publication() {
	local cfg="$1" enabled proto target name auth acl header a h guid output
	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get proto "$cfg" proto
	config_get target "$cfg" target
	if [ -z "$proto" ] || [ -z "$target" ]; then
		log "skipping publication '$cfg': protocol or address is not set"
		return 0
	fi

	guid="$(registered_guid_for_target "$proto" "$target")"
	if [ -n "$guid" ]; then
		remember_guid "$guid"
		log "publication already registered: $proto $target ($guid)"
		return 0
	fi

	config_get name "$cfg" name
	config_get auth "$cfg" auth
	config_get acl "$cfg" acl
	config_get header "$cfg" header
	set -- register
	[ -n "$name" ] && set -- "$@" --name "$name"
	[ -n "$auth" ] && [ "$auth" != "none" ] && set -- "$@" --auth "$auth"
	for a in $acl; do set -- "$@" --acl "$a"; done
	for h in $header; do set -- "$@" --header "$h"; done
	set -- "$@" "$proto" "$target"

	if output="$(clo "$@" 2>&1)"; then
		guid="$(extract_guid "$output")"
		remember_guid "$guid"
		log "registered publication: $proto $target"
	else
		log "failed to register publication: $proto $target: $output"
		SYNC_OK=0
	fi
}

remove_deleted_publications() {
	local guid
	for guid in $(printf '%s\n' "$REGISTERED" | grep -Eio '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | sort -u); do
		[ -n "$guid" ] || continue
		if ! grep -Fqx "$guid" "$DESIRED_GUIDS" 2>/dev/null; then
			if clo unpublish "$guid" >/dev/null 2>&1; then
				log "removed deleted publication: $guid"
			else
				log "failed to remove deleted publication: $guid"
				SYNC_OK=0
			fi
		fi
	done
}

load_config() {
	. /lib/functions.sh
	config_load cloudpub
	config_get LOG_LEVEL main log_level "info"
}

set_client_options() {
	local token unsafe_tls
	config_get token main token
	config_get_bool unsafe_tls main unsafe_tls 0
	[ -n "$token" ] || {
		log "API token is not set, service will not start"
		return 1
	}
	clo set token -- "$token" >/dev/null 2>&1 || return 1
	# Do not write the default on every boot: this can rewrite client.toml and
	# discard state that the client uses to reconnect existing publications.
	[ "$unsafe_tls" -eq 1 ] && clo set unsafe_tls true >/dev/null 2>&1
	return 0
}

reconcile() {
	local attempt list_ok=0
	REGISTERED=
	for attempt in 1 2 3 4 5 6; do
		if REGISTERED="$(clo ls 2>&1)"; then
			list_ok=1
			break
		fi
		log "CloudPub list is not ready (attempt $attempt/6): $REGISTERED"
		sleep 5
	done

	: > "$DESIRED_GUIDS"
	SYNC_OK=1
	if [ "$list_ok" -ne 1 ]; then
		log "publication sync deferred until CloudPub is reachable"
		return 1
	fi

	config_foreach register_publication publish
	remove_deleted_publications
	[ "$SYNC_OK" -eq 1 ]
}

cleanup() {
	rm -f "$DESIRED_GUIDS"
}
trap cleanup EXIT INT TERM

load_config
mkdir -p "$CONFDIR"
chmod 0700 "$CONFDIR"
set_client_options || exit 1

# OpenWrt starts services concurrently from procd. Give local services a
# short head start, then reconcile exactly once before the persistent agent.
sleep 10
reconcile || exit 1
exec "$PROG" --conf "$CONF" --log-level "$LOG_LEVEL" -v run
