#!/bin/sh
set -eu

REPO="BrainDeLook/CloudPub-OpenWRT"
LATEST_URL="${LATEST_URL:-https://github.com/$REPO/releases/latest/download}"
LOCAL_RELEASE="${LOCAL_RELEASE:-/usr/share/cloudpub-openwrt/release}"
STATE="${STATE:-/tmp/cloudpub-update-status}"
ACTION="${1:-update}"

fetch() {
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -O "$2" "$1"
	elif command -v wget >/dev/null 2>&1; then
		wget -q -O "$2" "$1"
	elif command -v curl >/dev/null 2>&1; then
		curl -fsSL "$1" -o "$2"
	else
		echo "No downloader found (uclient-fetch, wget or curl is required)." >&2
		exit 1
	fi
}

current_release() {
	tr -d '\r\n ' < "$LOCAL_RELEASE" 2>/dev/null || printf 'unknown'
}

write_state() {
	local current="$1" latest="$2" available="$3" checked="$4"
	umask 077
	{
		printf 'current=%s\n' "$current"
		printf 'latest=%s\n' "$latest"
		printf 'available=%s\n' "$available"
		printf 'checked=%s\n' "$checked"
	} > "$STATE.tmp"
	mv "$STATE.tmp" "$STATE"
}

status() {
	if [ -s "$STATE" ]; then
		cat "$STATE"
	else
		local current
		current="$(current_release)"
		write_state "$current" "$current" 0 0
		cat "$STATE"
	fi
}

check_update() {
	local tmp="/tmp/cloudpub-update-release.$$" current latest available
	trap "rm -f '$tmp'" EXIT INT TERM
	current="$(current_release)"
	fetch "$LATEST_URL/release" "$tmp" || {
		echo "Unable to check the latest CloudPub add-on release." >&2
		return 1
	}
	latest="$(tr -d '\r\n ' < "$tmp")"
	case "$latest" in
		''|*[!A-Za-z0-9._-]*)
			echo "The release server returned an invalid version." >&2
			return 1
			;;
	esac
	available=0
	[ "$latest" = "$current" ] || available=1
	write_state "$current" "$latest" "$available" "$(date +%s)"
	status
}

install_update() {
	local tmp="/tmp/cloudpub-update.$$"
	trap "rm -rf '$tmp'" EXIT INT TERM
	mkdir -p "$tmp"

	echo "Downloading the latest CloudPub OpenWrt installer..."
	fetch "$LATEST_URL/install.sh" "$tmp/install.sh"
	[ -s "$tmp/install.sh" ] || {
		echo "Downloaded installer is empty." >&2
		exit 1
	}
	sh -n "$tmp/install.sh"
	sh "$tmp/install.sh"
	# The installed package carries the new release marker. Remove the old
	# cached state so LuCI cannot continue showing a stale update notification
	# if the follow-up network check is unavailable.
	rm -f "$STATE"
}

case "$ACTION" in
	status) status ;;
	check) check_update ;;
	update) install_update ;;
	*)
		echo "Usage: $0 {status|check|update}" >&2
		exit 2
		;;
esac
