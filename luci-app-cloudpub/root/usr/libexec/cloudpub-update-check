#!/bin/sh

channel="${1:-stable}"
case "$channel" in
    stable|beta) ;;
    *) exit 2 ;;
esac

API='https://api.github.com/repos/BrainDeLook/CloudPub-OpenWRT/releases?per_page=50'
FETCH='/usr/bin/uclient-fetch'
[ -x "$FETCH" ] || FETCH='/usr/bin/wget'

json="$($FETCH -qO- "$API" 2>/dev/null)" || exit 1
current="$(cat /etc/cloudpub/release-tag 2>/dev/null)"
candidate=
candidate_name=
candidate_date=
current_date=
i=0

while [ "$i" -lt 50 ]; do
    tag="$(printf '%s' "$json" | jsonfilter -e "@[$i].tag_name" 2>/dev/null)"
    [ -n "$tag" ] || break
    name="$(printf '%s' "$json" | jsonfilter -e "@[$i].name" 2>/dev/null)"
    prerelease="$(printf '%s' "$json" | jsonfilter -e "@[$i].prerelease" 2>/dev/null)"
    draft="$(printf '%s' "$json" | jsonfilter -e "@[$i].draft" 2>/dev/null)"
    published="$(printf '%s' "$json" | jsonfilter -e "@[$i].published_at" 2>/dev/null)"

    [ "$tag" = "$current" ] && current_date="$published"
    if [ -z "$candidate" ] && [ "$draft" != "true" ]; then
        if { [ "$channel" = stable ] && [ "$prerelease" != "true" ]; } || \
           { [ "$channel" = beta ] && [ "$prerelease" = "true" ]; }; then
            candidate="$tag"
            candidate_name="$name"
            candidate_date="$published"
        fi
    fi
    i=$((i + 1))
done

case "$candidate" in
    v[0-9]*) ;;
    *) exit 1 ;;
esac

status=current
if [ "$candidate" != "$current" ]; then
    if [ -z "$current_date" ]; then
        status=update
    else
        newest="$(printf '%s\n%s\n' "$current_date" "$candidate_date" | sort | tail -n1)"
        [ "$newest" = "$candidate_date" ] && [ "$candidate_date" != "$current_date" ] && status=update
    fi
fi

printf '%s\t%s\t%s\t%s\t%s\n' "$status" "$channel" "$candidate" "$candidate_name" "$current"
