msgid "CloudPub"
msgstr "CloudPub"

msgid "CloudPub client publishes local services to the Internet through a secure tunnel."
msgstr "Клиент CloudPub публикует локальные сервисы в интернете через защищённый туннель."

msgid "Get your API token in the personal dashboard:"
msgstr "Получите API-токен в личном кабинете:"

msgid "Settings"
msgstr "Настройки"

msgid "Service status"
msgstr "Состояние службы"

msgid "Collecting data ..."
msgstr "Сбор данных ..."

msgid "Running"
msgstr "Работает"

msgid "Not running"
msgstr "Не запущена"

msgid "Enable"
msgstr "Включить"

msgid "API token"
msgstr "API-токен"

msgid "Personal API token from the CloudPub dashboard."
msgstr "Персональный API-токен из личного кабинета CloudPub."

msgid "Log level"
msgstr "Уровень журнала"

msgid "Error"
msgstr "Ошибки"

msgid "Warning"
msgstr "Предупреждения"

msgid "Info"
msgstr "Информация"

msgid "Debug"
msgstr "Отладка"

msgid "Skip TLS verification"
msgstr "Не проверять сертификат TLS"

msgid "Do not verify the server TLS certificate. Only needed for self-hosted servers with a self-signed certificate."
msgstr "Не проверять TLS-сертификат сервера. Нужно только для self-hosted серверов с самоподписанным сертификатом."

msgid "Restart service"
msgstr "Перезапустить службу"

msgid "Apply the token and re-register all publications."
msgstr "Применить токен и заново зарегистрировать все публикации."

msgid "CloudPub service restarted."
msgstr "Служба CloudPub перезапущена."

msgid "Update add-on"
msgstr "Обновить аддон"

msgid "Check for updates"
msgstr "Проверить обновления"

msgid "Add-on updates"
msgstr "Обновления аддона"

msgid "Updates are checked automatically every 24 hours."
msgstr "Наличие обновлений проверяется автоматически каждые 24 часа."

msgid "Update status has not been checked yet."
msgstr "Наличие обновлений ещё не проверялось."

msgid "Update available: %s → %s"
msgstr "Доступно обновление: %s → %s"

msgid "The latest add-on version is installed: %s"
msgstr "Установлена последняя версия аддона: %s"

msgid "Last checked: %s"
msgstr "Последняя проверка: %s"

msgid "unknown"
msgstr "неизвестно"

msgid "Update check failed."
msgstr "Не удалось проверить наличие обновлений."

msgid "Download and install the latest CloudPub client and LuCI add-on from GitHub Releases."
msgstr "Скачать и установить последние версии клиента CloudPub и LuCI-аддона из GitHub Releases."

msgid "Update CloudPub now? The service will be restarted."
msgstr "Обновить CloudPub сейчас? Служба будет перезапущена."

msgid "Updating CloudPub"
msgstr "Обновление CloudPub"

msgid "Downloading and installing the latest release ..."
msgstr "Скачивание и установка последнего релиза ..."

msgid "Update failed."
msgstr "Не удалось выполнить обновление."

msgid "CloudPub was updated successfully. The page will reload."
msgstr "CloudPub успешно обновлён. Страница будет перезагружена."

msgid "Publications"
msgstr "Публикации"

msgid "Local services that will be published to the Internet. After saving, the service is restarted and the publications are registered automatically."
msgstr "Локальные сервисы, которые будут опубликованы в интернете. После сохранения служба перезапускается и публикации регистрируются автоматически."

msgid "Enabled"
msgstr "Включена"

msgid "Name"
msgstr "Название"

msgid "optional"
msgstr "необязательно"

msgid "Protocol"
msgstr "Протокол"

msgid "Local address"
msgstr "Локальный адрес"

msgid "Port (8080), host and port (192.168.1.10:8080) or path, depending on the protocol."
msgstr "Порт (8080), хост и порт (192.168.1.10:8080) или путь — в зависимости от протокола."

msgid "Authentication"
msgstr "Аутентификация"

msgid "None"
msgstr "Нет"

msgid "Basic Auth"
msgstr "Basic Auth"

msgid "Form Auth"
msgstr "Через форму"

msgid "Access rules (ACL)"
msgstr "Правила доступа (ACL)"

msgid "Access rules in the form email:role. Roles: admin, reader, writer."
msgstr "Правила доступа в формате email:роль. Роли: admin, reader, writer."

msgid "Extra HTTP headers"
msgstr "Дополнительные HTTP-заголовки"

msgid "Headers added to requests sent to the local server, in the form Name:Value."
msgstr "Заголовки, добавляемые к запросам на локальный сервер, в формате Имя:Значение."

msgid "Active publications"
msgstr "Активные публикации"

msgid "No data (service is not running or no publications are registered)."
msgstr "Нет данных (служба не запущена или публикации не зарегистрированы)."
